# Database (en prod : URL de la ressource PostgreSQL Coolify)
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/regie_db?schema=public

# API
API_PORT=3003
PORT=3003
NODE_ENV=development

# CORS - domaines autorisés (séparés par virgule)
CORS_ORIGIN=http://localhost:3000

# Keycloak (routes /api/* du back-office). Non défini en dev = auth désactivée.
# KEYCLOAK_URL=https://plateform-auth.orkessidev.com
KEYCLOAK_REALM=konitys

# Tout compte Keycloak du realm entre : créé à sa première connexion. Ce qu'il peut faire vient des droits
# Konitys (Admin Panel → Profils & Droits, clé « regie »), lus sur le gateway : voir KONITYS_GATEWAY_URL plus bas.

# Notifications : e-mails par Mailjet, SMS par SMSEnvoi (comme le CRM Selfizee).
# Sans identifiants : rien n'est envoyé, les envois sont seulement journalisés.
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
NOTIF_EXPEDITEUR_EMAIL=alertes@selfizee.fr   # expéditeur validé dans Mailjet
NOTIF_EXPEDITEUR_NOM=Régie Selfizee
# SMSENVOI_EMAIL=
# SMSENVOI_APIKEY=
# SMSENVOI_VERSION=3.0.4
SMS_EXPEDITEUR=SELFIZEE
# URL du front, pour les liens dans les e-mails
APP_URL=http://localhost:3000

# Ingestion
TVA_DEFAUT_BP=2000
INGEST_BODY_LIMIT=2mb

# Tests d'intégration (base dédiée, vidée à chaque lancement)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5435/regie_test?schema=public

# Météo des lieux : Météo-France (historique) et MET Norway (prévisions), gratuits, sans clé.
# MET Norway demande que chaque requête identifie l'application et un contact (e-mail ou site) :
# METEO_CONTACT=contact@selfizee.fr   (à défaut : APP_URL)
# Vacances scolaires, météo et codes postaux synchronisés toutes les 6 h (0 pour couper)
DONNEES_EXTERNES=1

# Google Places (API « Places API (New) ») : catégorie, note et avis des emplacements des concurrents.
# Clé d'un projet Google Cloud de Selfizee, restreinte à « Places API (New) ». Vide = bouton « Vérifier sur Google » masqué.
# GOOGLE_PLACES_API_KEY=

# Page souvenir et page publique « Mes photos »
# Base du lien imprimé en QR (#TOKEN# = code d'événement-photo_uuid), écrite dans le config.json des événements.
# Adresse de la page souvenir déployée ; sans #TOKEN#, /p/#TOKEN# est ajouté. Republier les événements après un changement.
# SOUVENIR_QR_BASE_URL=https://myevent.selfizee.fr/p/#TOKEN#
# API PikCloud (séances, e-mails des invités) : vide = recherche simulée, seul le code d'exemple K7PX2M répond
# PIKCLOUD_URL=
# API de la page souvenir (/souvenir/v1, projet souvenirs) : secret partagé avec son serveur (en-tête X-Souvenir-Token),
# qui signe aussi les URLs des visuels. Vide = API désactivée (503). Même valeur que SOUVENIR_API_SECRET de la page souvenir.
# SOUVENIR_API_SECRET=
# Adresse publique de cette API pour les URLs des visuels (défaut : l'hôte de la requête de la page souvenir)
# SOUVENIR_URL_FICHIERS=https://api-regie.selfizee.fr
# Recette : 1 = les séances de test (is_fake, testMode) s'affichent sur la page souvenir
# SOUVENIR_SEANCES_TEST=
# Mails de la page souvenir (livraison, code gagné, lien « Toutes tes photos ») : envoyés par Mailjet (MAILJET_API_KEY /
# MAILJET_API_SECRET ci-dessus). Expéditeur : adresse seule ou « Nom <adresse> », à valider dans Mailjet (SPF / DKIM / DMARC).
# SENDER_SELFIZEE=Selfizee <photos@selfizee.fr>
# Adresse de la page souvenir pour les liens des mails (défaut : l'origine de SOUVENIR_QR_BASE_URL)
# SOUVENIR_PAGE_URL=https://myevent.selfizee.fr
# SOUVENIR_URL_FICHIERS sert aussi à l'aperçu de la photo et aux liens suivis des mails : à renseigner en production.
# Rebonds : webhook Mailjet (événements bounce et blocked) vers https://<api>/webhooks/v1/mailjet?cle=<MAILJET_WEBHOOK_SECRET>
# MAILJET_WEBHOOK_SECRET=
# Photo d'une vente (récapitulatif d'une commande) : adresse de l'image avec {uuid} = photo_uuid PikCloud
# PHOTOS_URL_MODELE=https://…/{uuid}/apercu.jpg

# Synchro des médias PikCloud → Régie (webhook POST /webhooks/v1/pikcloud/medias, docs/synchronisation-pikcloud.md)
# Secret partagé avec PikCloud, envoyé dans l'en-tête X-Synchro-Token ; vide = webhook désactivé (503, PikCloud renverra)
# PIKCLOUD_SYNCHRO_SECRET=
# Hôtes dont on accepte les liens de téléchargement (défaut : api.pikcloud.io, apidev.pikcloud.io)
# PIKCLOUD_HOTES_AUTORISES=api.pikcloud.io,apidev.pikcloud.io
# Vérification HEAD (3 s) des liens à la réception, pour répondre 4002 tout de suite si un lien ne répond pas : 0 pour couper
# PIKCLOUD_VERIFIER_LIENS=1
# Dossier où sont copiés les médias (volume Docker en prod ; PikCloud efface ses fichiers après 90 jours)
MEDIAS_DIR=./medias
# Taille maximale d'un média (vidéos jusqu'à ~100 Mo d'après le contrat)
# MEDIAS_TAILLE_MAX_MO=200
# Échecs de téléchargement avant abandon (le fichier passe en erreur, un renvoi PikCloud le relance)
# MEDIAS_TENTATIVES_MAX=5
# Rétention : fichiers supprimés N jours après la séance (la ligne et ses compteurs restent). Vide = pas de purge,
# durée à fixer par Selfizee (la page souvenir purge à 90 jours)
# MEDIAS_RETENTION_JOURS=

# Plateforme Konitys (Hub) : passerelle lue à la connexion (photo des comptes) et cloche des notifications (mentions).
# DEV : https://plateformdev-gateway.orkessi.com — PROD : https://plateform-gateway.orkessi.com
# KONITYS_GATEWAY_URL=https://plateform-gateway.orkessi.com
# Slug de l'app pour les notifications (filtre côté Hub)
# KONITYS_APP_SLUG=regie
# Champs du téléphone dans la fiche Hub (/api/users/me), pour les alertes SMS
# KONITYS_CHAMPS_TELEPHONE=telephone,tel,phone,phone_number,mobile,portable

# Droits Konitys (docs/PERMISSIONS_APP_INTEGRATION.md) : lus sur /api/permissions/me de KONITYS_GATEWAY_URL
# (c'est le GATEWAY_URL du guide). Sans valeur, les contrôles laissent tout passer (fail-open),
# sauf le périmètre des lieux (mode fermé : chacun ne voit que ses lieux).
