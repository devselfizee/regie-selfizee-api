# Database (en prod : URL de la ressource PostgreSQL Coolify)
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/regie_db?schema=public

# API
API_PORT=3003
PORT=3003
NODE_ENV=development

# CORS - domaines autorisés (séparés par virgule)
CORS_ORIGIN=http://localhost:3000

# Keycloak (routes /api/* du back-office). Non défini en dev = auth désactivée.
# KEYCLOAK_URL=https://plateform-auth.orkessidev.com
KEYCLOAK_REALM=konitys

# Comptes créés automatiquement en ADMIN à leur première connexion (séparés par des virgules).
# Les autres utilisateurs sont ajoutés par un admin (page Utilisateurs).
ADMIN_EMAILS=prenom.nom@selfizee.fr

# Notifications : e-mails par Mailjet, SMS par SMSEnvoi (comme le CRM Selfizee).
# Sans identifiants : rien n'est envoyé, les envois sont seulement journalisés.
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
NOTIF_EXPEDITEUR_EMAIL=alertes@selfizee.fr   # expéditeur validé dans Mailjet
NOTIF_EXPEDITEUR_NOM=Régie Selfizee
# SMSENVOI_EMAIL=
# SMSENVOI_APIKEY=
SMS_EXPEDITEUR=SELFIZEE
# URL du front, pour les liens dans les e-mails
APP_URL=http://localhost:3000

# Ingestion
TVA_DEFAUT_BP=2000
INGEST_BODY_LIMIT=2mb

# Tests d'intégration (base dédiée, vidée à chaque lancement)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5435/regie_test?schema=public

# Météo des lieux (Open-Meteo) : gratuit pour un usage non commercial seulement.
# Pour la production, prendre un abonnement Open-Meteo et renseigner la clé.
# OPEN_METEO_API_KEY=
# Vacances scolaires, météo et codes postaux synchronisés toutes les 6 h (0 pour couper)
DONNEES_EXTERNES=1
