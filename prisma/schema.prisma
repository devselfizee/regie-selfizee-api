// Bibliothèque des séries d'illustrations « type » gérées par Selfizee (mariage, corporate…), choisies dans
// les fiches événement et copiées dans le zip (mémo ILLUSTRATIONS-ADMIN-WEB § 3a)
model IllustrationSerie {
