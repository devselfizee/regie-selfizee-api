// ─── Médias des séances (synchro PikCloud) ──────────────────

// Un média par séance de borne, reçu de PikCloud par le webhook (docs/synchronisation-pikcloud.md).
// Clé du contrat : (code_event, filename). Le JSON de la séance (data) et le média (photo) peuvent
// arriver séparément et dans n'importe quel ordre : chacun a son URL et son état. Un renvoi ne
// remplace jamais un fichier déjà reçu. Les paiements du JSON ne sont pas exploités (source du CA :
// l'ingestion des ventes), le JSON complet reste dans `brut`.
model Media {
  id   BigInt @id @default(autoincrement())
  // Identifiant interne : nom du fichier sur le stockage et clé des URLs de la galerie
  uuid String @unique @default(uuid()) @db.Uuid

  codeEvent  String  @map("code_event") @db.VarChar(8) // code de l'événement (R…), = config_evenements.code
  filename   String // nom de base des fichiers, sans extension (2026_11_04_21_42_17_00031) : clé commune au JSON et au média
  // Nom du média avec son extension, tel que PikCloud le donne : name_photo du JSON de séance, à défaut la fin de media_url
  nomFichier String? @map("nom_fichier")

  // Rattachement : événement et lieu par le code (null si inconnu : stocké quand même), borne par son identifiant
  configEvenementId Int?   @map("config_evenement_id")
  lieuId            Int?   @map("lieu_id")
  borneId           Int?   @map("borne_id")
  borneIdentifiant  String @map("borne_identifiant")
  typeMedia         String @map("type_media") // photo, multipose, video, gif-multipose… valeur inconnue acceptée
  importId          BigInt @map("import_id") // appel qui a créé la ligne

  // Lus dans le JSON de la séance (null tant qu'il n'est pas téléchargé)
  photoUuid String?   @map("photo_uuid") @db.Uuid // identifiant PikCloud de la séance, celui du QR imprimé
  datePhoto DateTime? @map("date_photo") @db.Timestamptz(3) // prise de vue
  dateSave  DateTime? @map("date_save") @db.Timestamptz(3) // enregistrement sur la borne (rétention)
  datePrint DateTime? @map("date_print") @db.Timestamptz(3) // premier tirage, null sans tirage
  nbTirages Int?      @map("nb_tirages")
  // Séance de test (is_fake de l'appel ou testMode du JSON) : hors galerie par défaut
  test      Boolean   @default(false)
  brut      Json? // JSON de la séance tel que reçu

  // Fichier JSON (data)
  dataUrl        String?       @map("data_url")
  dataStatut     FichierStatut @default(ABSENT) @map("data_statut")
  // Fichier média (photo) : URL opaque, copie locale sur MEDIAS_DIR (chemin relatif)
  mediaUrl       String?       @map("media_url")
  mediaStatut    FichierStatut @default(ABSENT) @map("media_statut")
  mediaChemin    String?       @map("media_chemin")
  vignetteChemin String?       @map("vignette_chemin")
  tailleOctets   Int?          @map("taille_octets")
  sha256         String?       @db.Char(64)
  tentatives     Int           @default(0)
  derniereErreur String?       @map("derniere_erreur")
  telechargeLe   DateTime?     @map("telecharge_le") @db.Timestamptz(3)
  // Fichier supprimé (mediaStatut PURGE) : pourquoi (RGPD = demande de l'invité, CONSERVATION = durée dépassée) et quand
  purgeMotif     String?       @map("purge_motif") @db.VarChar(12)
  purgeLe        DateTime?     @map("purge_le") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  evenement ConfigEvenement? @relation(fields: [configEvenementId], references: [id], onDelete: SetNull)
  lieu      Lieu?            @relation(fields: [lieuId], references: [id], onDelete: SetNull)
  borne     Borne?           @relation(fields: [borneId], references: [id], onDelete: SetNull)
  import    ImportLot        @relation(fields: [importId], references: [id])

  @@unique([codeEvent, filename])
  @@index([configEvenementId, datePhoto])
  @@index([lieuId, datePhoto])
  @@index([photoUuid])
  @@index([dataStatut])
  @@index([mediaStatut])
  @@index([dateSave])
  @@map("medias")
}

// État d'un fichier (JSON ou média) d'une séance PikCloud
enum FichierStatut {
  ABSENT // pas encore annoncé par PikCloud
  A_TELECHARGER // URL reçue, téléchargement en attente
  TELECHARGE // copie locale faite (média) ou JSON lu (data)
  ERREUR // échecs répétés : visible dans la file d'erreurs, un renvoi PikCloud relance
  PURGE // fichier supprimé par la rétention, la ligne reste
}

// ─── Page souvenir : ce que l'invité y fait (CDC page souvenir § 1.2, § 4, § 9) ───
// Décision du 06/11/2026 : stocké dans la Régie (la page souvenir passe par /souvenir/v1, jamais par la base).
// La séance est désignée par le jeton (code d'événement + photo_uuid), comme la table medias.

// Inscription « Recevoir mes photos » : plusieurs par séance (photo de groupe). E-mail, prénom, IP et navigateur
// sont effacés à 90 jours (conservation, CDC § 9.2) sauf opt-in, ou à la demande de l'invité (§ 9.3).
model SouvenirInscription {
  id                String    @id @default(uuid()) @db.Uuid
  codeEvent         String    @map("code_event") @db.VarChar(8)
  photoUuid         String    @map("photo_uuid") @db.Uuid
  configEvenementId Int?      @map("config_evenement_id")
  lieuId            Int?      @map("lieu_id")
  email             String? // null une fois anonymisée
  prenom            String?
  estMoi            Boolean   @map("est_moi")
  optinLieu         Boolean   @map("optin_lieu")
  optinSelfizee     Boolean   @map("optin_selfizee")
  // Textes exacts des cases au moment du consentement (preuve, CDC § 4.2)
  textes            Json
  ipTronquee        String?   @map("ip_tronquee") @db.VarChar(64)
  userAgent         String?   @map("user_agent") @db.VarChar(400)
  anonymiseeLe      DateTime? @map("anonymisee_le") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  evenement  ConfigEvenement?    @relation(fields: [configEvenementId], references: [id], onDelete: SetNull)
  lieu       Lieu?               @relation(fields: [lieuId], references: [id], onDelete: SetNull)
  livraisons SouvenirLivraison[]
  carte      SouvenirCarte?

  @@index([codeEvent, photoUuid])
  @@index([lieuId, createdAt])
  @@index([email])
  @@map("souvenir_inscriptions")
}

// État d'une livraison (mail 1, CDC § 6.1)
enum EtatLivraison {
  EN_ATTENTE_MEDIA // inscription faite avant l'arrivée de la photo
  A_ENVOYER // photo là : le planificateur l'envoie par Mailjet (src/souvenir/envois.ts)
  ENVOYE
  ECHEC // rebond dur (webhook Mailjet), ou envoi refusé après plusieurs essais
  PHOTO_INTROUVABLE // photo toujours absente 24 h après l'inscription : mail « on n'a pas retrouvé ta photo » envoyé
}

// Livraison du mail 1 : la première, puis chaque « Renvoyer »
model SouvenirLivraison {
  id            BigInt        @id @default(autoincrement())
  inscriptionId String        @map("inscription_id") @db.Uuid
  renvoi        Boolean       @default(false)
  etat          EtatLivraison
  envoyeLe      DateTime?     @map("envoye_le") @db.Timestamptz(3)
  erreur        String?
  // Essais d'envoi refusés par le fournisseur, et quand réessayer (espacement croissant)
  tentatives    Int           @default(0)
  prochainEssai DateTime?     @map("prochain_essai") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  inscription SouvenirInscription @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)

  @@index([inscriptionId])
  @@index([etat])
  @@map("souvenir_livraisons")
}

// Carte à gratter : une par inscription, lot tiré côté serveur (CDC § 7). Un lot gagné est un vrai code de remise
// de la Régie (valable 30 jours sur toutes les bornes en régie), que la borne vérifie comme les autres.
model SouvenirCarte {
  id                Int       @id @default(autoincrement())
  inscriptionId     String    @unique @map("inscription_id") @db.Uuid
  lot               String    @db.VarChar(8) // none, pct30, pct50, free
  codeRemiseId      Int?      @unique @map("code_remise_id")
  reveleeLe         DateTime? @map("revelee_le") @db.Timestamptz(3)
  // Mail 2 (code gagné, CDC § 6.2) : envoyé à la révélation d'un lot
  mailEnvoyeLe      DateTime? @map("mail_envoye_le") @db.Timestamptz(3)
  mailErreur        String?   @map("mail_erreur")
  mailTentatives    Int       @default(0) @map("mail_tentatives")
  mailProchainEssai DateTime? @map("mail_prochain_essai") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  inscription SouvenirInscription @relation(fields: [inscriptionId], references: [id], onDelete: Cascade)
  codeRemise  CodeRemise?         @relation(fields: [codeRemiseId], references: [id], onDelete: SetNull)

  @@map("souvenir_cartes")
}

// Lien magique « Toutes tes photos » (CDC § 4.6) : 24 h ; seul son empreinte SHA-256 est gardée
model SouvenirLien {
  id        Int       @id @default(autoincrement())
  jetonHash String    @unique @map("jeton_hash") @db.Char(64)
  email     String
  expireLe  DateTime  @map("expire_le") @db.Timestamptz(3)
  ouvertLe  DateTime? @map("ouvert_le") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expireLe])
  @@map("souvenir_liens")
}

// Analytique de la page (CDC § 4.8) : compteurs serveur, sans donnée personnelle ni cookie tiers
model SouvenirJournal {
  id        BigInt   @id @default(autoincrement())
  evenement String   @db.VarChar(30) // page_view, registered, scratch_revealed…
  codeEvent String?  @map("code_event") @db.VarChar(8)
  photoUuid String?  @map("photo_uuid") @db.Uuid
  lieuId    Int?     @map("lieu_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([lieuId, evenement, createdAt])
  @@index([photoUuid, evenement])
  @@map("souvenir_journal")
}

// ─── Mails paramétrables (Paramètres → E-mails RGPD) ───
// Sujet et corps (texte riche nettoyé) d'un mail envoyé par la Régie, avec des variables {{…}} remplacées à l'envoi.
// Une ligne par modèle modifié : sans ligne, le texte par défaut du code (src/rgpd/modeles.ts) s'applique.
model ModeleMail {
  cle           String   @id @db.VarChar(40) // RGPD_ACCES, RGPD_NOTIFICATION
  sujet         String   @db.VarChar(200)
  corps         String
  // Notifications internes : adresses séparées par des virgules (vide : pas d'envoi)
  destinataires String?  @db.VarChar(500)
  modifieParId  Int?     @map("modifie_par_id")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  modifiePar User? @relation(fields: [modifieParId], references: [id], onDelete: SetNull)

  @@map("modeles_mail")
}

// ─── Mise à jour des événements sur les bornes (13/11/2026) ───
// Ce que la borne signale après avoir chargé le zip d'un événement (POST /ingest/v1/evenements/installation) : la
// Régie sait ainsi quelle version tourne sur chaque borne. Une ligne par signalement (historique).
enum EtatInstallation {
  DEMANDE // la borne a demandé le zip et reçu son lien (/statut)
  ENVOYE // la Régie a servi le zip (téléchargement commencé)
  TELECHARGE // zip reçu et vérifié (sha256), pas encore installé
  INSTALLE // événement installé, prêt sur la borne
  ECHEC // téléchargement ou installation raté (message)
}

// Qui a lancé le téléchargement : la mise à jour automatique (programme) ou un code tapé sur la borne
enum Declencheur {
  AUTO
  MANUEL
}

// Journal des téléchargements d'événements (page « Téléchargements ») : lignes ajoutées seulement, jamais modifiées.
// Pensé pour le volume : lieu copié dans la ligne (filtre sans jointure), lecture par curseur sur id, purge à 180 jours.
model InstallationEvenement {
  id                BigInt           @id @default(autoincrement())
  borneId           Int              @map("borne_id")
  configEvenementId Int?             @map("config_evenement_id")
  code              String           @db.VarChar(8)
  version           Int
  etat              EtatInstallation
  declencheur       Declencheur?
  // Lieu de l'événement au moment de la ligne (copie : filtre et périmètre sans jointure)
  lieuId            Int?             @map("lieu_id")
  message           String?          @db.VarChar(500)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  borne     Borne            @relation(fields: [borneId], references: [id], onDelete: Cascade)
  evenement ConfigEvenement? @relation(fields: [configEvenementId], references: [id], onDelete: SetNull)

  @@index([borneId, id])
  @@index([lieuId, id])
  @@index([configEvenementId, id])
  @@index([createdAt])
  @@map("installations_evenement")
}
