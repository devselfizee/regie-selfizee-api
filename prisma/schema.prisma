  // Lieu retrouvé sur Google Places (null = pas encore cherché ; googleVerifieLe sans placeId = introuvable)
  googlePlaceId   String?   @map("google_place_id")
  googleNom       String?   @map("google_nom")
  googleType      String?   @map("google_type")
