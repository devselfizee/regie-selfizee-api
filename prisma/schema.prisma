  concurrent Concurrent @relation(fields: [concurrentId], references: [id], onDelete: Cascade)
  lieu       Lieu?      @relation(fields: [lieuId], references: [id], onDelete: SetNull)
  typeLieu   RefValeur? @relation(fields: [typeLieuId], references: [id], onDelete: SetNull)

